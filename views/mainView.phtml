<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda Online</title>
</head>
<body>
    <h1>BIENVENIDOS A LA TIENDA</h1>
    <div style="margin-bottom: 20px;">
        <?php
        if(isset($_SESSION['user'])){
            echo "BIENVENIDO " . htmlspecialchars($_SESSION['user']->getUsername()) . " | <a href='index.php?c=product&new'>Subir producto</a> | <a href='index.php?logout'>Cerrar sesión</a>";
        } else {
            echo "<a href='index.php?login'>Iniciar Sesión</a> | <a href='index.php?register'>Registrarse</a>";
        }
        ?>
    </div>
    <hr>
    <h2>Productos</h2>
    <div>
        <?php
        if(isset($products) && $products){
            foreach($products as $product){
                $name = is_array($product) ? ($product['name'] ?? '') : ($product->name ?? '');
                $price = is_array($product) ? ($product['price'] ?? '') : ($product->price ?? '');
                $stock = is_array($product) ? ($product['stock'] ?? '') : ($product->stock ?? '');
                echo "<p><strong>" . htmlspecialchars($name) . "</strong> - Precio: " . htmlspecialchars($price) . "€ - Stock: " . htmlspecialchars($stock) . "</p>";
            }
        } else {
            echo "<p>No hay productos disponibles.</p>";
        }
        ?>
    </div>
</body>
</html>