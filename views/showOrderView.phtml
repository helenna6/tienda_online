                echo "</form> ";
                echo "<form action='index.php?c=order&update' method='POST' style='display:inline;'>";
                echo "<input type='hidden' name='id' value='".$ol->getId()."'>";
                echo "<input type='hidden' name='quantity' value='".($ol->getQuantity()+1)."'>";
                echo "<button type='submit'>+</button>";
                echo "</form>";
                echo "<br><br>";
            }
            echo "Total: ".$order->getTotal()." €";
            echo "<br><br>";

            if(count($order->getOrderLines()) > 0){
                echo "<form action='index.php?c=order&checkout' method='POST'>";
